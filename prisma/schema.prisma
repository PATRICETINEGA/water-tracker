generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  logs      WaterLog[]
  createdAt DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(cuid())
  amount    Int      // ml
  date      String   // YYYY-MM-DD
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
